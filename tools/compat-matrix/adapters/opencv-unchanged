#!/bin/bash
source "$(dirname "$0")/lib.sh"
ADAPTER_VERSION=$(python3 -c 'import cv2; print("OpenCV "+cv2.__version__)' 2>&1)
export ADAPTER_VERSION
T0=$(ms_now)
ERR=$(python3 /opt/adapters/py/opencv_decode.py "$1" "$2" unchanged 2>&1) && ST=ok || ST=error
T1=$(ms_now)
write_json "$ST" "$2" "$3" $((T1-T0)) "$ERR"
