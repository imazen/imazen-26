#!/bin/bash
source "$(dirname "$0")/lib.sh"
IN="$1" OUT="$2" JSON="$3"
ADAPTER_VERSION=$(pngtopam -version  </dev/null 2>&1 | head -1)
export ADAPTER_VERSION
# pamtopng (not pnm_to_png/PIL): 16-bit PAMs are PIL-unreadable, and the pipe
# carries alpha through losslessly.
png_to_png() { pngtopam -alphapam "$1" | pamtopng >"$2"; }
export -f png_to_png
run_adapter "$OUT" "$JSON" png_to_png "$IN" "$OUT"
