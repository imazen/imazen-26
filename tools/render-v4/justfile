    OPENBLAS_NUM_THREADS="${OMP_NUM_THREADS:-1}" MKL_NUM_THREADS="${OMP_NUM_THREADS:-1}" NUMEXPR_NUM_THREADS="${OMP_NUM_THREADS:-1}" MAGICK_THREAD_LIMIT="${OMP_NUM_THREADS:-1}" python3 "{{justfile_directory()}}/../../scripts/colour_oracle.py" "{{out}}/report.tsv" {{quote(out)}} {{quote(originals)}} "{{out}}/list.tsv" {{if source_render == "" { "" } else { "--source-render " + quote(source_render) }}}
    OPENBLAS_NUM_THREADS="${OMP_NUM_THREADS:-1}" MKL_NUM_THREADS="${OMP_NUM_THREADS:-1}" NUMEXPR_NUM_THREADS="${OMP_NUM_THREADS:-1}" MAGICK_THREAD_LIMIT="${OMP_NUM_THREADS:-1}" python3 "{{justfile_directory()}}/../../scripts/hdr_oracle.py" "{{out}}/hdr-report.tsv" {{quote(out)}} "{{out}}/list.tsv" {{quote(hdrinfo)}}

