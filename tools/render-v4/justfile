# Called under the shared heavy-job lock after all repository upload receipts exist.
publish-verified stage repos receipts:
    @just --justfile {{quote(justfile())}} publish-corpus sync-docs {{quote(stage)}} {{quote(repos)}} {{quote(receipts)}}
    @just --justfile {{quote(justfile())}} publish-corpus verify-git {{quote(stage)}} {{quote(repos)}} {{quote(receipts)}}
    @just --justfile {{quote(justfile())}} publish-corpus expose {{quote(stage)}} {{quote(repos)}} {{quote(receipts)}}
    @just --justfile {{quote(justfile())}} publish-corpus client-check {{quote(stage)}} {{quote(repos)}} {{quote(receipts)}}

publication-progress log:
    tail -n 6 {{quote(log)}}

resume-corpus stage repos receipts:
    python3 "{{justfile_directory()}}/../../scripts/publish_corpus.py" repositories {{quote(stage)}} {{quote(repos)}} {{quote(receipts)}} --resume

# Image files are already compressed; these are Git transport/storage settings only.
publication-pack repo:
    git -C {{quote(repo)}} config core.compression 1
    git -C {{quote(repo)}} config pack.compression 1
    git -C {{quote(repo)}} config pack.window 0

