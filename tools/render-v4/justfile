# Compare every sample/metadata hash on the same inputs before and after decoder changes.
candidate-decode-parity root binary baseline list files="4300" jobs="6":
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p "{{root}}/readback"
    {{quote(binary)}} jxl --jobs {{jobs}} < {{quote(list)}} > "{{root}}/readback/candidate.tsv" 2> "{{root}}/readback/candidate.log"
    python3 "{{justfile_directory()}}/../../scripts/compare_decoder_readback.py" {{quote(baseline)}} "{{root}}/readback/candidate.tsv" --files {{files}} --out "{{root}}/readback/comparison.json"

cohort-check roots out:
    python3 "{{justfile_directory()}}/../../scripts/check_codec_cohort.py" {{quote(roots)}} {{quote(out)}}

colour-oracles out originals hdrinfo:
    python3 "{{justfile_directory()}}/../../scripts/colour_oracle.py" "{{out}}/report.tsv" {{quote(out)}} {{quote(originals)}} "{{out}}/list.tsv"
    python3 "{{justfile_directory()}}/../../scripts/hdr_oracle.py" "{{out}}/hdr-report.tsv" {{quote(out)}} "{{out}}/list.tsv" {{quote(hdrinfo)}}

