# Fresh sample directory planned by current_main_samples.py; no shipped files change.
sample-encodes out jobs="3" binary="":
    #!/usr/bin/env bash
    set -euo pipefail
    binary={{quote(binary)}}
    if [ -z "$binary" ]; then binary="{{justfile_directory()}}/target/release/render-v4"; fi
    "$binary" png-sdr --jobs {{jobs}} "{{out}}/list.tsv" "{{out}}" > "{{out}}/report.tsv"
    "$binary" gain-maps --jobs {{jobs}} "{{out}}/hdr-list.tsv" "{{out}}" > "{{out}}/gain-maps-report.tsv"
    "$binary" png-hdr --jobs {{jobs}} "{{out}}/hdr-list.tsv" "{{out}}" > "{{out}}/hdr-report.tsv"
    "$binary" jxl --effort 9 --jobs {{jobs}} "{{out}}/list.tsv" "{{out}}" > "{{out}}/jxl-report.tsv"
    "$binary" jxl-hdr --effort 9 --jobs {{jobs}} "{{out}}/hdr-list.tsv" "{{out}}" > "{{out}}/jxl-hdr-report.tsv"

recover-identical-report candidate reference:
    python3 "{{justfile_directory()}}/../../scripts/recover_identical_jxl_report.py" {{quote(candidate)}} {{quote(reference)}}

jxl-check out jobs="3":
    python3 "{{justfile_directory()}}/../../scripts/render_v4_jxl_check.py" {{quote(out)}} --jobs {{jobs}}

# The byte scanner emits only finding names/offsets, never matched coordinate values.
byte-scans out originals:
    #!/usr/bin/env bash
    set -euo pipefail
    result=0
    for layer in png-p3 png-srgb jxl-p3 jxl-srgb imi-p3 imi-srgb gain-maps; do
        python3 "{{justfile_directory()}}/../../scripts/byte_scan.py" "{{out}}/$layer" --out "{{out}}/byte-scan-$layer.tsv" || result=1
    done
    python3 "{{justfile_directory()}}/../../scripts/byte_scan.py" {{quote(originals)}} --paths "{{out}}/../originals-byte-scan.list" --out "{{out}}/byte-scan-originals.tsv" || result=1
    exit "$result"

# Standalone source snapshots and explicit compatibility overrides retain their own locks.
beta-check-tools root config:
    CARGO_TARGET_DIR={{quote(root + "/target")}} cargo --config {{quote(config)}} build --release --locked --manifest-path {{quote(root + "/render-v4/Cargo.toml")}}
    CARGO_TARGET_DIR={{quote(root + "/target")}} cargo --config {{quote(config)}} build --release --locked --manifest-path {{quote(root + "/jxl-decode-check/Cargo.toml")}}

# Each receipt run gets a fresh directory; prior build evidence is retained.
beta-tool-receipts root config out:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir {{quote(out)}}
    cargo --config {{quote(config)}} metadata --locked --format-version 1 --manifest-path {{quote(root + "/render-v4/Cargo.toml")}} > "{{out}}/render-v4-metadata.json"
    cargo --config {{quote(config)}} metadata --locked --format-version 1 --manifest-path {{quote(root + "/jxl-decode-check/Cargo.toml")}} > "{{out}}/jxl-decode-check-metadata.json"
    python3 "{{justfile_directory()}}/../../scripts/record_tool_build.py" "{{root}}/render-v4/Cargo.toml" "{{root}}/target/release/render-v4" "{{out}}/render-v4-metadata.json" "{{out}}/render-v4-build.json"
    python3 "{{justfile_directory()}}/../../scripts/record_tool_build.py" "{{root}}/jxl-decode-check/Cargo.toml" "{{root}}/target/release/jxl-decode-check" "{{out}}/jxl-decode-check-metadata.json" "{{out}}/jxl-decode-check-build.json"

# A staged, explicit lossless redo: all three readers, PNG twins and structural gates.
subset-check root binary lib inventory commit jobs="3":
    #!/usr/bin/env bash
    set -euo pipefail
    scripts="{{justfile_directory()}}/../../scripts"
    python3 "$scripts/check_jxl_subset.py" prepare {{quote(root)}}
    {{quote(binary)}} png --jobs {{jobs}} < "{{root}}/subset-check/png.list" > "{{root}}/subset-check/png.tsv" 2> "{{root}}/subset-check/png.log"
    {{quote(binary)}} jxl --jobs {{jobs}} < "{{root}}/subset-check/jxl.list" > "{{root}}/subset-check/native.tsv" 2> "{{root}}/subset-check/native.log"
    {{quote(lib)}} < "{{root}}/subset-check/jxl.list" > "{{root}}/subset-check/libjxl.tsv" 2> "{{root}}/subset-check/libjxl.log"
    for layer in jxl-p3 jxl-srgb; do
        python3 "$scripts/byte_scan.py" "{{root}}/$layer" --out "{{root}}/subset-check/byte-scan-$layer.tsv"
    done
    python3 "{{justfile_directory()}}/../metadata-loss-audit/inventory_routes.py" "{{root}}/subset-check/inventory-list.tsv" "{{root}}/subset-check/inventory" --inventory {{quote(inventory)}} --inventory-commit {{quote(commit)}}
    python3 "$scripts/check_jxl_subset.py" verify {{quote(root)}}

